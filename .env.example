# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# CLIENT-EXPOSED VARIABLES (VITE_ prefix)
# Vite only inlines VITE_-prefixed variables into the browser bundle — the
# Vite equivalent of the Next.js NEXT_PUBLIC_ prefix. Everything here ships to
# the browser: never put a secret in a VITE_ variable.
# ---------------------------------------------------------------------------
# Supabase Credentials (Found in Supabase Project Settings -> API)
# The anon key is safe for browsers because RLS enforces row-level access.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paddle Billing v2 Configuration (browser checkout opened by SubmitModal.tsx)
VITE_PADDLE_CLIENT_TOKEN="live_..." # Or test_...
VITE_PADDLE_ENV="sandbox" # 'sandbox' or 'production'
VITE_PADDLE_PRICE_ID="pri_01h..." # $5 flat fee one-time product price ID (500 cents)

# Admin allow-list for the review queue / feature toggles (comma-separated).
# App.tsx also accepts the singular VITE_ADMIN_EMAIL fallback.
VITE_ADMIN_EMAILS="" # e.g. "you@example.com,partner@example.com"

# ---------------------------------------------------------------------------
# SERVER-ONLY VARIABLES (no prefix)
# Read inside the /api functions via process.env; never bundled for the browser.
# Set these in Vercel -> Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------
# Server-side only (bypasses RLS). Required by api/paddle-webhook.ts and
# api/admin-tools.ts (the review queue's approve/reject/delete writes) — never
# expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# Admin allow-list used by api/admin-tools.ts to authorise moderation writes
# (comma-separated). Separate from VITE_ADMIN_EMAILS, which only decides what the
# browser renders; the API accepts either name.
ADMIN_EMAILS="" # e.g. "you@example.com,partner@example.com"

# APP_URL: Public base URL of the deployment (e.g. https://apps.stackbuildco.com).
# api/paddle-webhook.ts also uses it to call /api/send-email for instant receipts;
# when it is unset the webhook falls back to the incoming request host.
APP_URL="MY_APP_URL"

PADDLE_API_KEY="pdl_..." # Optional: only needed for server-side Paddle API calls (none today)
PADDLE_WEBHOOK_SECRET_KEY="pdl_ntf_set_..." # Found in Paddle Notifications / Webhooks settings. Required in production: api/paddle-webhook.ts verifies every request with it and refuses unverifiable webhooks.

# Resend: transactional email (payment receipts, offers, approvals, support).
# Required by api/send-email.ts — api/paddle-webhook.ts triggers an instant
# PAYMENT_RECEIPT to the buyer after every successful $5 Featured upgrade.
RESEND_API_KEY="re_..."
# Keep onboarding@resend.dev until your own sending domain is verified in Resend.
RESEND_FROM_EMAIL="StackDirectory <onboarding@resend.dev>"
